<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/quick_note"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:background="@drawable/widget_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_w_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_take_note"
            android:textColor="@color/widget_muted"
            android:textSize="15sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/quick_list"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="2dp"
        android:contentDescription="@string/shortcut_list"
        android:padding="10dp"
        android:src="@drawable/ic_w_list" />

    <ImageView
        android:id="@+id/quick_drawing"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/shortcut_drawing"
        android:padding="10dp"
        android:src="@drawable/ic_w_drawing" />

    <ImageView
        android:id="@+id/quick_photo"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/shortcut_photo"
        android:padding="10dp"
        android:src="@drawable/ic_w_photo" />
</LinearLayout>
